# Copy to .env in this directory and fill in real values. .env is gitignored — the token and
# hostname below are deploy-time secrets/config, never committed.

# At least one surface must be configured: the Discord token below, or both Slack tokens
# further down. The bot process holds no other credential — see
# packages/control-plane-bot/src/index.ts.

# Discord application's bot token (Developer Portal -> Bot -> Reset Token).
DISCORD_BOT_TOKEN=

# Slack bot token (xoxb-...), shown on the app's Settings -> Install App page after installing
# it to the workspace. Create the app from deploy/slack-app-manifest.yml.
SLACK_BOT_TOKEN=

# Slack app-level token (xapp-...) with the connections:write scope — Socket Mode's WebSocket
# credential, generated under Settings -> Basic Information -> App-Level Tokens.
SLACK_APP_TOKEN=

# Public hostname this VPS answers to. Caddy requests a TLS certificate for it and reverse
# proxies wss:// traffic to the bot; the CLI's default relay URL points at wss://<this>. Must
# already resolve to this machine's IP before `docker compose up` (Let's Encrypt needs to
# reach it over HTTP-01/TLS-ALPN-01 to issue the cert).
RELAY_HOSTNAME=relay.example.com

# Optional: text channel id that hosts per-session private threads, for every paired user not
# named in CCTL_SESSION_CHANNELS below. Unset (or blank), those users' session output is
# delivered by DM instead. Two-way threads (typing replies into a thread and having them reach
# the session) also need the Message Content intent enabled on the Discord application
# (Developer Portal -> Bot -> Message Content Intent). This is a DEFAULT: a user's own
# /thread-here overrides it in both directions — their own channel, or back to their DMs.
#CCTL_SESSION_CHANNEL_ID=

# Optional: per-user overrides, as comma-separated <discordUserId>:<channelId> pairs. A user
# named here gets threads in their own channel; anyone else falls back to
# CCTL_SESSION_CHANNEL_ID above, or to DM when that is unset. Setting ONLY this one gives the
# named users threads while every other paired user stays on DMs. A malformed pair fails
# startup rather than silently leaving that user on DMs. Also a DEFAULT: a user's own
# /thread-here outranks the entry you write for them here, in both directions. Neither variable
# is an access control — neither can stop someone reading their own session output — so to
# control where the bot may post, use the channel's Discord permissions, which /thread-here
# checks (and really tests) before it pins anything.
#CCTL_SESSION_CHANNELS=123456789012345678:987654321098765432
