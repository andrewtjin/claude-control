{
  "name": "@claude-control/channel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cctl-channel": "./dist/bin.js"
  },
